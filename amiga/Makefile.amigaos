# 2048-in-terminal for GFOS (AmigaOS 3.2 with GFOpenUp), 68040/68060: the
# sliding-tile game in its own 80 x 24 console window, in colour, built
# soft float (the stove's fpuauto uses the FPU when the Amiga has one). No
# SDL, no ACGame, no GFOpenGPU.
#
#   make -f amiga/Makefile.amigaos -j4 UP=/path/to/2048-in-terminal [STOVE=...]
#
# UP is upstream at the commit package/2048.lock names, with amiga/patches
# applied (package/build-amiga.sh does both). STOVE is a GFOpenAmigaGCC
# 16.2.0-open6 stove (prefix/ has the compiler and the NDK). The game draws
# through amiga/curses.c (the part of ncurses it uses, sent to the console
# as ANSI with the eight pens for colour); amiga/console_amiga.c opens the
# window and reads the keys (amiga/keys.c: the cursor keys as KEY_*).
#
# Output: build/amigaos/2048/ (the drawer: 2048, ReadMe, the licence,
# GlowIcons), build/amigaos/2048.info and Install-2048 beside them.

UP      ?= ../2048-in-terminal
STOVE   ?= $(HOME)/AmiCradle/stoves/os32-gcc16-open6
PREFIX  ?= $(STOVE)/prefix
CC      = $(PREFIX)/bin/m68k-amigaos-gcc
CPU     ?= -m68040 -msoft-float
# -fno-tree-loop-distribute-patterns: GCC 16's loop miscompile.
OPT     ?= -Os -fomit-frame-pointer -fno-tree-loop-distribute-patterns

UPFLAGS = -noixemul $(OPT) $(CPU) -std=gnu11 -D_GNU_SOURCE -D__amigaos__ -Iamiga/include -Iamiga
MYFLAGS = -noixemul $(OPT) $(CPU) -std=gnu99 -Wall -Iamiga/include -Iamiga
LDFLAGS = -noixemul $(CPU)

BUILD   = build/amigaos
OBJ     = $(BUILD)/obj
OUT     = $(BUILD)/2048

GAME    = board draw main save
PORT    = curses keys console_amiga

all: $(OUT)/2048 package

$(OBJ)/up/%.o: $(UP)/src/%.c $(wildcard amiga/include/*.h)
	@mkdir -p $(dir $@)
	$(CC) $(UPFLAGS) -c -o $@ $<

$(OBJ)/port/%.o: amiga/%.c $(wildcard amiga/*.h amiga/include/*.h)
	@mkdir -p $(dir $@)
	$(CC) $(MYFLAGS) -c -o $@ $<

$(OUT)/2048: $(GAME:%=$(OBJ)/up/%.o) $(PORT:%=$(OBJ)/port/%.o)
	@mkdir -p $(OUT)
	$(CC) $(LDFLAGS) -o $@ $^

package: $(OUT)/2048 AMIGA_PORT.md
	cp AMIGA_PORT.md $(OUT)/ReadMe
	cp $(UP)/LICENSE $(OUT)/LICENSE.txt
	cp amiga/icons/2048.info amiga/icons/ReadMe.info $(OUT)/
	cp amiga/icons/ReadMe.info $(OUT)/LICENSE.txt.info
	cp amiga/icons/2048-drawer.info $(BUILD)/2048.info
	cp amiga/Install-2048 amiga/Install-2048.info $(BUILD)/

clean:
	rm -rf $(BUILD)

.PHONY: all package clean
